# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC...
DEFAULT_CHAT_ID=@mychannel

# --- source 1: chosen accounts (free RSS, no login) ---
# X usernames, comma separated. "name=@otherchannel" sends that account somewhere else.
# Leave empty if you only want the For you feed.
X_ACCOUNTS=NASA,SpaceX,esa=@otherchannel

# --- source 2: your "For you" feed (headless browser + your X login cookies) ---
# WARNING: treat the two cookie values like a password and only put them in Render's secret
# environment variables. Automating a logged-in X session is against X's terms and can get the
# account limited or suspended: use a spare account, not your main one.
FOR_YOU=false
# Browser dev tools -> Application/Storage -> Cookies -> https://x.com : copy the VALUES of
# "auth_token" and "ct0" of the account whose For you feed you want.
X_AUTH_TOKEN=
X_CT0=
FOR_YOU_CHAT_ID=@mychannel      # defaults to DEFAULT_CHAT_ID
FOR_YOU_MAX_NEW=40              # at most this many new For-you posts are looked up per cycle
FOR_YOU_SCROLLS=4               # how many times the page is scrolled to load more posts
FOR_YOU_WAIT_SECS=25            # how long to wait for the timeline to appear
FOR_YOU_SELECT_TAB=true         # click the "For you" tab if X opens on "Following"
INSENSITIVE_X=true              # inject AgebypassX + InsensitiveX scripts (remove age gate / sensitive-content warnings)
BROWSER_KIND=lightpanda         # or "chromium" (own PC/VPS with >= 1 GB RAM; untested)
BROWSER_BIN=/usr/local/bin/lightpanda
BROWSER_PORT=9222
PAGE_TIMEOUT_SECS=90
BROWSER_RECYCLE_CYCLES=12       # restart the browser every N cycles

# --- free data sources (no X API, no keys) ---
# Nitter-style RSS instances serving /<user>/rss, tried in order. Public ones come and go:
# list several, or self-host one (then use e.g. http://my-nitter:8080).
RSS_SOURCES=https://xcancel.com
# FxEmbed API used to read each post's text and media
FX_API=https://api.fxtwitter.com

# --- durable state (strongly recommended on Render Free: its disk is wiped on every restart) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_STATE_BRANCH=bot-state

# --- optional (defaults shown) ---
POLL_INTERVAL_SECS=300          # minimum 60 (default 600 when FOR_YOU=true)
REQUEST_GAP_SECS=3              # pause between accounts (be polite to the free services)
CYCLE_BUDGET_SECS=240           # stop starting new accounts after this long; the rest run next cycle
SEND_GAP_MS=3000                # minimum gap between Telegram sends to one channel
MEDIA_ONLY=true                 # false = also forward text-only posts
INCLUDE_REPLIES=false
INCLUDE_REPOSTS=true
SEND_CAPTIONS=true              # false = media alone, no author/text/link
MIN_LIKES=0                     # only forward posts with at least this many likes (re-checked while young)
LIKES_WAIT_MIN=60               # how long a post below MIN_LIKES keeps being re-checked
MAX_AGE_HOURS=24                # never forward posts older than this
SEND_BACKLOG_ON_FIRST_RUN=false # false = first run only records existing posts
MAX_UPLOAD_BYTES=52428800       # Telegram bot limit is 50 MB
MEDIA_HOSTS=twimg.com           # media is only downloaded from these hosts (https only)
MAX_ACCOUNTS=100
SEEN_CAP=20000                  # a floor: raised automatically to cover MAX_AGE_HOURS of examined posts (max 100000)
SELF_PING_ENABLED=true
SELF_PING_INTERVAL_SECS=600
STATE_FLUSH_MIN_SECS=60
RUST_LOG=info
